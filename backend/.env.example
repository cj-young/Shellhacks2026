# Port to listen on. Railway provides PORT; locally it defaults to 3001.
PORT=3001

# Comma-separated browser origins allowed to call the API and open Socket.IO.
# Set this to the Vercel deployment origin on Railway, e.g.:
#   https://chop-chop.vercel.app,https://*.vercel.app
# Entries may contain a single '*' wildcard. Empty keeps the same-origin
# (local/Caddy) behaviour.
ALLOWED_ORIGINS=

# Optional round length override in milliseconds (default: 180000).
# ROUND_DURATION_MS=180000
