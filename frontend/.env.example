# Backend endpoints for the deployed frontend. Set these in Vercel (build time);
# Vite inlines them into the client bundle, so changes need a redeploy.

# Base URL for REST calls.
#   development (Caddy):   /api
#   production (Railway):  https://your-app.up.railway.app
VITE_API_URL=/api

# Socket.IO origin. Empty keeps the current origin (development behind Caddy).
#   production (Railway):  https://your-app.up.railway.app
VITE_SOCKET_URL=

# Socket.IO path.
#   development (Caddy):   /api/socket.io/
#   production backend:    /socket.io/
VITE_SOCKET_PATH=/api/socket.io/
